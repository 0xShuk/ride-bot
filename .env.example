# Copy to .env for local runs. On Render, set these as environment variables (secrets).

# Solana mainnet RPC (Helius etc.)
RPC_URL=

# Bot wallet secret key: the JSON byte array from solana-keygen, or base58. Live runs only.
BOT_KEYPAIR=
# For a dry run without the secret key: the bot wallet's address.
BOT_WALLET=

ANTHROPIC_API_KEY=
BIRDEYE_API_KEY=
JUPITER_API_KEY=

# Render Postgres connection string. Required live; a dry run without it keeps records in memory.
DATABASE_URL=

# Optional: Telegram alerts (otherwise they only go to the log)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

RIDE_API_URL=https://ride-api.fly.dev

# true = decide and report, never send transactions
DRY_RUN=false
# true = open no new calls (open calls still run to their end)
KILL_SWITCH=false
