{
  "name": "ride-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node scripts/start-all.mjs",
    "start:one": "tsx src/index.ts",
    "local": "tsx --env-file=.env src/index.ts",
    "local:once": "tsx --env-file=.env src/index.ts --once",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "analyze": "tsx --env-file=.env scripts/analyze.ts",
    "compare": "tsx --env-file=.env scripts/compare.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "@coral-xyz/anchor": "^0.32.1",
    "@solana/web3.js": "^1.98.0",
    "bs58": "^6.0.0",
    "pg": "^8.13.1",
    "tsx": "^4.19.2",
    "tweetnacl": "^1.0.3",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "typescript": "^5.7.3",
    "vitest": "^4.1.7"
  }
}
